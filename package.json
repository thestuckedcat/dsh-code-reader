{
  "name": "@local/dsh-code-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Source-grounded Linux driver and user-space code reading/learning tools for DeepSeek Harness: workspace registration, bounded source evidence, Atlas snapshot queries, cross-repo ABI bridge candidates and versioned learning records.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./bundle/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "bundle/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/",
    "engine/code_learning/*.py",
    "engine/schemas/*.json",
    "docs/implementation-route.md",
    "docs/mechanisms.md",
    "docs/implementation-contract.md",
    "docs/readonly-workbench-contract.md",
    "docs/five-view-contract.md",
    "docs/scenario-contract.md",
    "docs/scenario-s3b-contract.md",
    "docs/interactive-code-view-software-design.md",
    "USAGE.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "source.lock.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "linux-kernel",
    "code-reading",
    "code-learning",
    "sdk-code-atlas"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "cd engine && python -m unittest discover -s tests -v",
    "test:node": "node --test tests/node/bridge.test.mjs tests/node/plugin.test.mjs tests/node/view-rpc.test.mjs tests/node/client.test.mjs"
  }
}
