{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestuckedcat/dsh-code-reader/schemas/capability-event.schema.json",
  "title": "CapabilityEventV1",
  "description": "Optional invalidation input from capability 03. It can only invalidate; it never proves freshness and never replaces local hash rechecks. Runtime validation lives in engine/code_learning/invalidation.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "kind", "source_capability", "scope_ref", "operation_id", "generation", "affected_refs", "outcome", "occurred_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["session_surface_rewound", "workspace_files_restored", "session_removed"]},
    "source_capability": {"type": "string", "minLength": 1, "maxLength": 64},
    "scope_ref": {"type": "string"},
    "session_ref": {"type": ["string", "null"]},
    "operation_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "affected_refs": {"type": "array", "items": {"type": "string"}},
    "outcome": {"enum": ["committed", "partial", "unknown"]},
    "before_snapshot": {"type": ["string", "null"]},
    "after_snapshot": {"type": ["string", "null"]},
    "occurred_at": {"type": "string"}
  }
}
