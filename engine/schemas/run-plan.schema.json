{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestuckedcat/dsh-code-reader/schemas/run-plan.schema.json",
  "title": "RunPlanV1",
  "description": "A frozen, non-executing plan for a future fixed-Atlas run. This version returns EXECUTION_BLOCKED at run time because no forced-isolation execution profile is provisioned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "workspace_id", "workspace_revision", "variant_id", "build_identity", "goal", "argv", "cwd_ref", "env_profile_ref", "read_roots", "write_root_ref", "required_capabilities", "execution_profile_ref", "request_digest", "budgets", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string"},
    "workspace_id": {"type": "string"},
    "workspace_revision": {"type": "integer", "minimum": 1},
    "variant_id": {"type": "string"},
    "build_identity": {"type": "object"},
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "interface"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "interface": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd_ref": {"type": "string"},
    "env_profile_ref": {"type": ["string", "null"]},
    "read_roots": {"type": "array", "items": {"type": "string"}},
    "write_root_ref": {"type": "string"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "execution_profile_ref": {"type": ["string", "null"]},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tu", "tu_timeout_s", "total_timeout_s"],
      "properties": {
        "max_tu": {"type": "integer", "minimum": 1, "maximum": 4096},
        "tu_timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600},
        "total_timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "expires_at": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
